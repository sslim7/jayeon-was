# 빌드 컨텍스트에서 뺄 것.
#
# 🔴 이 파일에 docs/ 를 절대 추가하지 말 것. main.go 가 docs/openapi.yaml 을
#    //go:embed 로 바이너리에 넣는다. 빠지면 `pattern docs/openapi.yaml: no matching files` 로
#    빌드가 깨진다.

# 버전 관리 메타데이터 — 이미지에 들어갈 이유가 없고 컨텍스트만 키운다
.git
.gitignore

# 🔴 자격증명 — 이미지 레이어에 박히면 이미지를 받는 누구나 읽을 수 있다.
#    특히 .env 는 컨테이너 안에 들어가면 godotenv 가 기동 시 실제로 읽어 버려
#    로컬 값이 운영 설정을 덮는다. .env.example 도 굳이 살릴 이유가 없어 통째로 뺀다.
#    (.dockerignore 패턴은 경로 전체와 매칭되므로 하위 디렉터리까지 잡으려면 **/ 가 필요하다.)
**/.env
**/.env.*
secrets/

# 로컬 에뮬레이터 산출물 (수백 MB 까지 커진다)
emulator-data*/
firebase-export-*/
**/*-debug.log

# 로컬 `go build` 산출물. 모듈명과 같은 이름이라 컨텍스트에 그대로 남아 있다(수십 MB).
# 빌더가 어차피 다시 컴파일하므로 넣을 이유가 없다.
/nature-was

# 에디터·도구 설정
.idea/
.claude/
.playwright-mcp/
**/.DS_Store

# 자기 자신 — 바뀌어도 캐시를 깰 필요가 없다
Dockerfile
.dockerignore

# *_test.go 는 일부러 남긴다.
# `go build` 가 테스트 파일을 무시하므로 이미지에는 어차피 안 들어가고,
# 나중에 같은 이미지에서 `go test` 나 `go vet ./...` 를 돌리고 싶을 때 제외해 두면 조용히 깨진다.

# 이전 이름의 로컬 바이너리
/jayeon-was
