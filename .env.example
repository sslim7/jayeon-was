# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋하지 않는다)
#   cp .env.example .env

# ── 로컬 개발 (Firestore 에뮬레이터) ──────────────────────
# 이 변수가 설정되면 Firestore SDK 가 자동으로 에뮬레이터에 붙는다.
# 이 변수가 있는 한 실수로라도 운영 Firestore 에 붙지 않는다.
# 운영에서는 절대 설정하지 않는다.
#
# 포트는 birdieup 과 겹치지 않게 8090 대를 쓴다 — 아래 PORT 주석의 표를 보라.
FIRESTORE_EMULATOR_HOST=localhost:8090

# 에뮬레이터 실행 시 사용한 프로젝트 ID 와 동일해야 한다.
# demo- 로 시작하면 완전 오프라인 모드 (실제 GCP 프로젝트도 Firebase 로그인도 필요 없다)
GOOGLE_CLOUD_PROJECT=demo-jayeon

# 서버가 listen 할 포트.
#
# 🔴 birdieup 과 겹치면 안 된다. 겹쳐서 「주소가 이미 사용 중」으로 죽으면 차라리 낫다 —
#    진짜 문제는 죽지 않는 경우다. 앱이 자기 API 대신 birdieup-was 를 부르고, 거기서 온
#    404 나 엉뚱한 응답을 자기 코드 탓으로 알고 한참을 헤맨다. 인증이 걸리면 더 고약해서
#    남의 프로젝트 토큰 규칙에 막힌 것을 자기 로그인 버그로 착각하게 된다.
#
#    birdieup 과 같은 모양으로 한 칸 옆에 잡았다. 새 포트를 잡을 때 이 표에 먼저 적는다.
#
#      | 프로젝트 | admin | app(dev) | Firestore 에뮬 | 에뮬 UI | WAS  | 테스트 에뮬 |
#      | birdieup | 3000  | 3003     | 8080          | 4000    | 8081 | 8085        |
#      | jayeon   | 3100  | 3103     | 8090          | 4090    | 8091 | 8095        |
#
#    테스트용 에뮬레이터가 따로인 이유: 개발용 에뮬레이터를 띄워 둔 채로도 테스트를 돌릴 수
#    있어야 한다. 같은 포트면 테스트가 개발 중인 로컬 데이터를 건드리거나 포트 충돌로 깨진다.
PORT=8091

# CORS 를 허용할 오리진 목록 (콤마 구분, 정확히 일치해야 한다).
# 비워두면 CORS 헤더를 아예 붙이지 않는다 — 이게 운영 기본값이다. 프론트 개발 서버 주소를 넣는다.
# 호스트 자리에 * 를 쓰면(예: http://*:3000) 사설 IP·루프백에서 스킴·포트가 일치할 때
# 허용한다 — 같은 네트워크의 폰으로 테스트할 때 DHCP 로 바뀌는 개발 머신 IP 대응용이다.
# 사설망 전용이므로 운영에서는 쓰지 말 것.
#
# 3103 은 jayeon-app 의 dev 서버, 3100 은 아직 없는 어드민 SPA 자리다.
# ⚠ 목록에서 빠진 오리진은 **서버가 에러를 내지 않는다** — 헤더를 조용히 안 붙일 뿐이라
#   서버 로그에는 200 으로 남고 브라우저에서만 막힌다. 원인 찾기가 유독 어려운 자리다.
CORS_ALLOWED_ORIGINS=http://localhost:3103,http://*:3103,http://localhost:3100,http://*:3100

# ── 인증 ─────────────────────────────────────────────────
# 사용자 토큰(JWT HS256)의 서명 키. 미설정이면 서버가 기동하지 않는다.
# 유출되면 남의 토큰을 위조할 수 있다. 로컬용 값을 아래 명령으로 만들어 쓴다.
#   openssl rand -base64 32
JWT_SECRET=<로컬용-랜덤-시크릿>

# 어드민 토큰(JWT HS256)의 서명 키.
#
# 🔴 **JWT_SECRET 과 반드시 다른 값이어야 한다. 같으면 서버가 기동하지 않는다.**
# 같은 키를 쓰면 어드민 토큰이 일반 사용자 미들웨어(internal/auth/middleware.go)의 서명
# 검증까지 통과한다. 그 미들웨어는 통과한 토큰의 sub 를 그대로 userId 로 컨텍스트에 넣는데,
# 어드민 토큰의 sub 는 문자열이 아니라 객체다 — 조용히 미인증으로 떨어지거나, 클레임 모양이
# 조금만 달라지면 어드민 토큰 하나로 남의 사용자 API 를 호출할 수 있게 된다.
# 경고로 넘길 수 있는 종류의 문제가 아니라 기동 거부다(internal/admin).
#
# **비워 두면 어드민 API 를 아예 등록하지 않는다**(/auth/admin.login 과 /admin/* 이 전부 404).
# 기동은 계속되고 경고만 남는다 — 어드민 키 하나 때문에 사용자 앱까지 죽을 이유가 없다.
# 로컬에서 어드민을 쓰려면 아래 명령으로 JWT_SECRET 과 다른 값을 만들어 채운다.
#   openssl rand -base64 32
ADMIN_JWT_SECRET=<로컬용-랜덤-시크릿-JWT_SECRET-과-다른-값>

# ── 운영 (GCP Firestore / Cloud Run) ─────────────────────
# Cloud Run 배포 시에는 .env 파일 대신 서비스 환경변수로 주입한다.
# 그 값들의 소유자는 Terraform(redhead-terraform)이다 — 배포 CI 는 이미지만 교체한다.
#
# FIRESTORE_EMULATOR_HOST 는 **설정하지 않는다.** 설정하지 않으면 프로젝트 ID 만 가지고
# ADC(Application Default Credentials)로 실제 Firestore 에 붙는다.
#
# PORT 는 Cloud Run 이 자동으로 주입하므로 설정하지 않는다. (미설정 시 8080)
#
# 확정된 운영 값:
#   GOOGLE_CLOUD_PROJECT=redhead
#   CORS_ALLOWED_ORIGINS=https://jayeon.redhead.kr
#     (앱 웹 빌드의 오리진. 어드민 SPA 가 생기면 콤마로 덧붙인다.
#      호스트 자리에 * 를 쓴 사설망 항목은 운영에 넣지 않는다.)
#
# JWT_SECRET / ADMIN_JWT_SECRET 은 Secret Manager 에 두고 Cloud Run 시크릿으로 마운트한다.
# 🔴 ADMIN_JWT_SECRET 은 JWT_SECRET 과 **다른 시크릿**이어야 하며,
#    두 값을 같은 시크릿에 연결하면 기동이 실패한다(위 ADMIN_JWT_SECRET 설명 참고).
